---
interface Props {
  locale?: 'en' | 'ja';
}
const { locale = 'en' } = Astro.props;
const ja = locale === 'ja';

const caps = ja
  ? ['ℓ = 0（LCD）', '0 < ℓ < k（一般の符号）', 'ℓ = k（自己直交）']
  : ['ℓ = 0 · LCD', '0 < ℓ < k · generic', 'ℓ = k · self-orthogonal'];
const notes = ja
  ? ['hull は 0 のみ', 'hull は ℓ 次元', 'hull は C 自身']
  : ['the hull is trivial', 'the hull has dimension ℓ', 'the hull is C itself'];
const figcap = ja
  ? 'Hull(C) = C ∩ C⊥ の次元 ℓ。両端が LCD 符号と自己直交符号で、その間に残りすべてが並ぶ。'
  : 'The hull Hull(C) = C ∩ C⊥ and its dimension ℓ. The LCD and the self-orthogonal codes are the two ends of one axis; everything else lies in between.';
---

<figure class="not-prose my-10">
  <div class="grid grid-cols-1 gap-6 rounded-xl border border-border bg-surface p-6 sm:grid-cols-3">
    {[0, 1, 2].map((i) => (
      <div class="text-center">
        <svg viewBox="0 0 120 90" class="w-full max-w-[220px] mx-auto" role="img" aria-label={caps[i]}>
          {i === 0 && (
            <g>
              <circle cx="32" cy="44" r="28" class="fill-none stroke-border" stroke-width="1.5" />
              <circle cx="88" cy="44" r="28" class="fill-none stroke-border" stroke-width="1.5" />
              <circle cx="60" cy="44" r="3" class="fill-accent" />
            </g>
          )}
          {i === 1 && (
            <g>
              <path d="M 60 24.404 A 28 28 0 0 1 60 63.596 A 28 28 0 0 1 60 24.404 Z" class="fill-accent" fill-opacity="0.28" />
              <circle cx="40" cy="44" r="28" class="fill-none stroke-border" stroke-width="1.5" />
              <circle cx="80" cy="44" r="28" class="fill-none stroke-border" stroke-width="1.5" />
            </g>
          )}
          {i === 2 && (
            <g>
              <circle cx="60" cy="44" r="34" class="fill-none stroke-border" stroke-width="1.5" />
              <circle cx="60" cy="50" r="19" class="fill-accent stroke-accent" fill-opacity="0.28" stroke-width="1.5" />
            </g>
          )}
          <g class="fill-text-muted" font-size="10" font-style="italic" text-anchor="middle">
            {i === 0 && <text x="26" y="48">C</text>}
            {i === 0 && <text x="92" y="48">C</text>}
            {i === 1 && <text x="28" y="48">C</text>}
            {i === 1 && <text x="94" y="48">C</text>}
            {i === 2 && <text x="60" y="54">C</text>}
            {i === 2 && <text x="60" y="22">C</text>}
          </g>
          <g class="fill-text-muted" font-size="7" text-anchor="middle">
            {i === 0 && <text x="99" y="43">&#8869;</text>}
            {i === 1 && <text x="101" y="43">&#8869;</text>}
            {i === 2 && <text x="67" y="17">&#8869;</text>}
          </g>
        </svg>
        <p class="mt-2 font-mono text-xs text-primary">{caps[i]}</p>
        <p class="mt-1 text-xs text-text-muted">{notes[i]}</p>
      </div>
    ))}
  </div>
  <figcaption class="mt-3 text-xs leading-relaxed text-text-muted">{figcap}</figcaption>
</figure>
