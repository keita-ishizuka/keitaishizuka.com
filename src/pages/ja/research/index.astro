---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import SectionNav from '../../../components/SectionNav.astro';
import HullVenn from '../../../components/HullVenn.astro';
import SamplerOrbit from '../../../components/SamplerOrbit.astro';
import PepColumns from '../../../components/PepColumns.astro';
import ReductionChain from '../../../components/ReductionChain.astro';
import HullReach from '../../../components/HullReach.astro';
import { refs } from '../../../data/research_refs';
import pubsData from '../../../data/publications.json';

const locale = 'ja' as const;

// 本文中の論文タイトルは、出版済みなら DOI、そうでなければ arXiv に飛ばす
const byId = new Map((pubsData.papers as any[]).map((p) => [p.id, p]));
const pubUrl = (id: number) => {
  const p = byId.get(id);
  if (!p) return null;
  if (p.doi) return `https://doi.org/${p.doi}`;
  if (p.arxiv) return `https://arxiv.org/abs/${p.arxiv}`;
  return null;
};

const navItems = [
  { id: 'hull', label: '線形符号の hull' },
  { id: 'sampler', label: '一様サンプラー' },
  { id: 'equivalence', label: '置換同値とグラフ同型' },
  { id: 'classification', label: '完全分類' },
  { id: 'references', label: '参考文献' },
];
---

<Layout
  title="研究 — 石塚 慶太"
  description="線形符号の hull とその次元を軸にした研究。hull 次元を指定した符号の厳密一様サンプリング、置換同値判定の計算量、2元・3元・4元エルミート LCD 符号の完全分類、符号ベース暗号とエンタングルメント支援量子符号への応用。"
>
  <Nav current="research" />
  <SectionNav locale={locale} items={navItems} inline={false} offset="24rem" />

  <main class="max-w-3xl mx-auto px-6 pt-28 pb-20">
    <div class="mb-2">
      <span class="text-accent font-mono text-sm font-medium">研究</span>
    </div>
    <h1 class="text-3xl font-bold text-primary tracking-tight mb-6">研究の関心</h1>

    <p class="text-lg text-text leading-relaxed mb-12">私の専門は誤り訂正符号理論です。誤り訂正符号は、もともと雑音のある通信路で通信を確実にするための技術です。しかし今では組合せ論の他の数学的対象と結びつき、以下で見るように暗号や量子誤り訂正へのさまざまな応用をもっています。このページでは、いま私が関心をもっていることを、主要な論文とともに説明します。</p>

    <div class="prose max-w-none text-text leading-relaxed">
      <section id="hull" class="scroll-mt-28">
        <h2 class="text-xl font-bold text-primary mb-4">線形符号の hull</h2>
        <p>線形符号とは F<sub>q</sub><sup>n</sup> の部分空間 <em>C</em> のことで、その双対 <em>C</em><sup>&perp;</sup> は（双線形形式あるいは半双線形形式に関する）<em>C</em> の直交空間です。<strong>hull</strong> は両者の共通部分であり、その次元 &#8467; は 0 から <em>k</em> = dim <em>C</em> までの値をとります。</p>

        <HullVenn locale={locale} />

        <p>hull は、自己双対符号など古典的な構造を含む、線形符号全体を記述する概念です。</p>
        <ul>
          <li>&#8467; = <em>k</em> のとき符号は双対に含まれ、自己直交符号と呼ばれます。2<em>k</em> = <em>n</em> なら自己双対符号です。</li>
          <li>&#8467; = 0 のとき符号と双対の交わりは自明で、これが LCD 符号の場合です。Massey <a href="#ref-1" class="cite">[1]</a> が導入し、独自の大きな文献をもちます。</li>
          <li>その間には残りすべてが並びます。</li>
        </ul>

        <p>hull の重要性を示す結果は数多くあります。</p>
        <ul>
          <li>自己直交符号は符号ベース署名方式 SPECK <a href="#ref-2" class="cite">[2]</a> のインスタンスそのものであり、hull 次元を指定した符号は Hollow LWE <a href="#ref-3" class="cite">[3]</a> の構成要素です。</li>
          <li>LCD 符号は、サイドチャネル攻撃とフォルトインジェクション攻撃への対策として利用できることが Carlet と Guilley <a href="#ref-4" class="cite">[4]</a> によって示されています。</li>
          <li>hull 次元は、置換同値問題の標準的な解法である support splitting algorithm <a href="#ref-5" class="cite">[5]</a> の計算コストを支配し、インスタンスの難しさを決めます。</li>
          <li>シンプレクティック形式とエルミート形式の場合、<em>C</em> の hull 次元は <em>C</em> から作るある種の量子誤り訂正符号（Entanglement-Assisted QECCs）における ebit 数そのものです <a href="#ref-6" class="cite">[6]</a><a href="#ref-7" class="cite">[7]</a>。つまり、ある種の量子符号はこれらの符号と等価です。</li>
        </ul>

        <p>このように、線形符号の hull は理論的にも応用的にも非常に興味深い対象です。私は現在、hull の特徴づけと、暗号・量子誤り訂正への応用に取り組んでいます。以下に示すのは、その一部です。</p>
      </section>

      <section id="sampler" class="scroll-mt-28">
        <h2 class="text-xl font-bold text-primary mt-12 mb-4">hull 次元を指定した線形符号の一様サンプラー</h2>
        <p><a href={pubUrl(18)} target="_blank" rel="noopener">Uniform Sampling of Linear Codes with Prescribed Hull Dimension</a> は、hull 次元 &#8467; の [<em>n</em>, <em>k</em>] 符号を厳密に一様にサンプリングするアルゴリズムを与えます。すべての有限体 F<sub>q</sub> と、標準的なすべての内積（ユークリッド・エルミート・シンプレクティック）を、ひとつの枠組みで扱うことができます。証明には反射的形式の古典理論、Witt の拡張定理とその分類 <a href="#ref-8" class="cite">[8]</a>、および群を一様にサンプリングする Diaconis–Shahshahani の部分群アルゴリズム <a href="#ref-9" class="cite">[9]</a> などを用いました。</p>

        <SamplerOrbit locale={locale} />

        <ul>
          <li>符号同値を利用する方式は、まさにこの一様サンプリングを仮定しています。SPECK <a href="#ref-2" class="cite">[2]</a> は鍵生成で一様ランダムな自己直交符号を構成し、Hollow LWE <a href="#ref-3" class="cite">[3]</a> は hull 次元を指定して一様ランダムな符号を構成することを仮定しています。しかし、これまで知られていた構成は奇標数・2<em>k</em> &le; <em>n</em> の場合に限られ、hull 次元だけを指定したときの出力は、一様分布から全変動距離 q<sup>&minus;(k&minus;&#8467;)/2</sup> の範囲に収まるだけでした <a href="#ref-10" class="cite">[10]</a>。本研究は、標準的なすべての内積とすべての標数について、厳密な一様性を保証します。</li>
          <li>また、上に述べたことから、ある種の方式の安全性の問題は符号の典型的な振る舞いに帰着します。サンプラーによって、その振る舞いの Monte Carlo シミュレーションと理論解析が可能になります。</li>
          <li>シンプレクティック形式とエルミート形式の場合、hull 次元は <em>C</em> から作るエンタングルメント支援量子符号が消費する ebit 数そのものです。したがって同じサンプラーが、ebit 数を指定した EAQECC を引くことになります。この帰結は QIP 2027 のポスターで発表します。</li>
          <li>置換同値によって符号を分類する際、通常は順序づけられた全列挙で進みます。符号を決まった順で生成し、これまでに分類した非同値な代表元と比較していくわけです。この方法では計算資源の制約から、順序で後ろに来る同値類には、現実には決して到達できないことがあります。サンプラーは、符号を一様ランダムに1つ返すことで、これを補う道具になります。論文では、有名なクーポン蒐集家の議論を適用して、分類に必要なサンプリングの回数を見積もりました。</li>
        </ul>
      </section>

      <section id="equivalence" class="scroll-mt-28">
        <h2 class="text-xl font-bold text-primary mt-12 mb-4">置換同値とグラフ同型</h2>
        <p>2つの符号が置換同値であるとは、座標の置換で一方が他方に写ることです。同値判定はあらゆる符号分類のボトルネックであり、同時にいくつかの暗号方式の困難性仮定でもあります。</p>

        <PepColumns locale={locale} />

        <p>Petrank と Roth は、グラフ同型は置換同値に帰着できることを示しました <a href="#ref-11" class="cite">[11]</a>。逆に、Bardet らは LCD 符号の同値判定をグラフ同型に帰着しました <a href="#ref-12" class="cite">[12]</a>。Babai のアルゴリズムはグラフ同型を準多項式時間で解くので <a href="#ref-13" class="cite">[13]</a>、LCD 符号の同値判定は易しいということになります。しかし、ここで自然な問いが生じます。それは、「置換同値がグラフ同型に帰着する符号は LCD 以外にあるのか」というものです。</p>
        <p><a href={pubUrl(11)} target="_blank" rel="noopener">The Closure of LCD-to-GI Reductions via Generalized Inner Products</a> は、その問いに対する答えです。ユークリッド内積を一般の双線形形式に置き換えると、議論を駆動する直交射影が一般化され、帰着は LCD の場合を越えて hull 次元 1 の一部にまで届きます。さらに、直交射影に基づく帰着で到達できるのはこれがすべてであることを証明しました。帰着できる符号は特徴づけと数え上げが済んでおり、符号全体に占める割合も分かっています。</p>

        <HullReach locale={locale} />

        <p>置換同値に関するもうひとつの仕事は、置換同値問題の標準的な解法である support splitting algorithm <a href="#ref-5" class="cite">[5]</a> についてです。このアルゴリズムの計算コストは hull 次元に支配されます。上と同じ一般化形式を使って、アルゴリズムが適用可能であるための条件を保ったまま hull 次元を下げられるのはいつかを特徴づけ、それが可能な次元のクラスを特定しました。この結果は <a href={pubUrl(16)} target="_blank" rel="noopener">Bilinear Hulls for Support Splitting</a> として SAC 2026 で発表しています。</p>
      </section>

      <section id="classification" class="scroll-mt-28">
        <h2 class="text-xl font-bold text-primary mt-12 mb-4">2元・3元・4元 LCD 符号の完全分類</h2>
        <p>ここまでの仕事では、符号理論から出発して結果を暗号に応用しました。逆に、次の仕事では、符号ベース暗号の解析で開発された技法を符号の分類に応用しました。</p>
        <p>Sendrier と Simos <a href="#ref-14" class="cite">[14]</a> が導入した線形符号の closure は、線形同値を置換同値に帰着します。しかも LCD であることを保つので、LCD-to-GI 帰着と合成すれば、線形同値から置換同値を経てグラフ同型へという連鎖が得られます。</p>

        <ReductionChain locale={locale} />

        <p>この帰着によって、Leon のアルゴリズム <a href="#ref-15" class="cite">[15]</a> では届かない長さまで分類を進めることができました。結果、2元 LCD 符号は長さ19、3元は長さ15、4元エルミートは長さ13まで分類を更新しました。さらに、これが到達可能な限界であることも論じました。次の長さへ進むと出力がテラバイトからペタバイト規模になり、現在の計算資源では保存も配布もできないことを示したのです。この結果は、<a href={pubUrl(24)} target="_blank" rel="noopener">Classification of binary, ternary and quaternary Hermitian LCD codes</a> として発表しました。</p>

        <p>各同値類の代表元は、2元 LCD 符号とそのグラフ表現とあわせてオープンデータとして公開しています。<a href="/ja/data/#lcd_classification">データ一覧はこちら</a>から入手できます。</p>
      </section>

      <section id="references" class="scroll-mt-28 not-prose">
        <h2 class="text-xl font-bold text-primary mt-12 mb-6">参考文献</h2>
        <ol class="space-y-3">
          {refs.map((r) => (
            <li id={`ref-${r.n}`} class="ref-item flex gap-3 text-sm leading-relaxed scroll-mt-28 px-2 py-1">
              <span class="font-mono text-xs text-text-muted shrink-0 pt-0.5">[{r.n}]</span>
              <span class="text-text">
                {r.text}
                {r.href && (
                  <a href={r.href} class="ml-2 font-mono text-xs text-accent hover:underline" target="_blank" rel="noopener">link</a>
                )}
              </span>
            </li>
          ))}
        </ol>
      </section>
    </div>
  </main>
</Layout>
